# URL base do alvo dos testes (padrão: API pública de demonstração)
BASE_URL=https://jsonplaceholder.typicode.com

# Nome do ambiente — usado apenas para taguear as métricas
ENV_NAME=public-demo

# Pasta de resultados usada pelo scripts/run.sh (via RESULTS_DIR)
RESULTS_DIR=results

# --- Perfil dynamic (por RPS) ---
# Cada jornada vira um cenário independente. Use 0 para desligar uma jornada.
# GET_RPS=20
# CREATE_RPS=5
# FULL_RPS=0
# DURATION=1m
